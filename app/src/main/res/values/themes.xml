<resources>
    <!-- Base application theme. -->
    <style name="Theme.PlantsHome" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- System bars: drawn by BaseActivity (edge-to-edge is required from Android 15). -->
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.PlantsHome.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.PlantsHome.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.PlantsHome.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>