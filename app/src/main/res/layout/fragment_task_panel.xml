<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@color/halfWhite"
    tools:context=".ui.taskpanel.TaskPanelFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/rounded_chip_nav"
        android:layout_marginTop="100dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:backgroundTint="@color/white"
        android:orientation="horizontal">

    <CheckBox
        android:id="@+id/taskCheck1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_margin="17dp"
        android:layout_marginRight="0dp"
        />


        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="0dp"
            android:src="@drawable/p12"
            android:contentDescription="@string/task_image"
            android:layout_gravity="center"
            android:gravity="center"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:id="@+id/taskText1"
            tools:text="It's time to water your Jade Pothos"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/rounded_chip_nav"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:backgroundTint="@color/white"
        android:orientation="horizontal">

        <CheckBox
        android:id="@+id/taskCheck2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_margin="17dp"
            android:layout_marginRight="0dp"
            />


        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="0dp"
            android:src="@drawable/p12"
            android:contentDescription="@string/task_image"
            android:layout_gravity="center"
            android:gravity="center"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:id="@+id/taskText2"
            tools:text="It's time to water your Jade Pothos"/>



    </LinearLayout>

    <Button
        android:id="@+id/btnCompletedTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="25dp"
        android:background="@drawable/button_rounded"
        android:backgroundTint="@android:color/white"
        android:drawableTint="@color/white"
        android:gravity="center"
        android:text="@string/task_completed"
        android:textColor="@color/white"

        app:backgroundTint="@color/green" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/rounded_chip_nav"
        android:layout_marginTop="25dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:backgroundTint="@color/white"
        android:orientation="horizontal">

        <CheckBox
        android:id="@+id/taskCheck3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:checked="true"
            android:layout_margin="17dp"
            android:layout_marginRight="0dp"
            />


        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="0dp"
            android:src="@drawable/p12"
            android:contentDescription="@string/task_image"
            android:layout_gravity="center"
            android:gravity="center"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:id="@+id/taskText3"
            tools:text="It's time to water your Jade Pothos"/>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/rounded_chip_nav"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:backgroundTint="@color/white"
        android:orientation="horizontal">

        <CheckBox
        android:id="@+id/taskCheck4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:checked="true"
            android:layout_margin="17dp"
            android:layout_marginRight="0dp"
            />


        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="0dp"
            android:src="@drawable/p12"
            android:contentDescription="@string/task_image"
            android:layout_gravity="center"
            android:gravity="center"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:id="@+id/taskText4"
            tools:text="It's time to water your Jade Pothos"/>


    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/rounded_chip_nav"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:backgroundTint="@color/white"
        android:orientation="horizontal">

        <CheckBox
        android:id="@+id/taskCheck5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:checked="true"
            android:layout_margin="17dp"
            android:layout_marginRight="0dp"
            />


        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="0dp"
            android:src="@drawable/p12"
            android:contentDescription="@string/task_image"
            android:layout_gravity="center"
            android:gravity="center"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:id="@+id/taskText5"
            tools:text="It's time to water your Jade Pothos"/>


    </LinearLayout>






</LinearLayout>